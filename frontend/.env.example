# URL pública de la API (el navegador usa el proxy /api/backend; esto vale para el servidor).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
API_URL=http://localhost:3000/api/v1

# Identidad del titular (el nombre y el correo ya tienen valor por defecto).
NEXT_PUBLIC_LEGAL_NAME=Carlos Tena
NEXT_PUBLIC_LEGAL_TAX_ID=pendingToAdd
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=radarvpo@gmail.com

# AdSense. Para salir de “Getting ready” hace falta:
# - ENABLED=true en el deploy
# - CLIENT_ID=ca-pub-XXXXXXXX (el ads.txt se deriva solo si falta PUBLISHER_ID)
# - al menos un SLOT real (no 1234567890)
# - /ads.txt público con google.com, pub-XXXXXXXX, DIRECT, f08c47fec0942fa0
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_CARD=

# Meta Pixel + Google Analytics 4 (gtag). Vacío = desactivar ese píxel.
# Nota: esto es GA4 gtag (G-…), no un contenedor GTM-….
NEXT_PUBLIC_META_PIXEL_ID=1303653491853194
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EQPBRQLPQ6
# Google Ads (conversiones). Sin AW-… / label, Ads no registrará compras aunque GA4 sí.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
